// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Minimum persisted shape for MindVault authentication. Login/session
// logic, roles, OAuth, and profile data are deliberately out of scope
// until they're designed.
model User {
  id String @id @default(cuid())

  // Application code must store this trimmed and lowercased so the
  // unique constraint behaves as a case-insensitive match in practice.
  email String @unique

  // Never store a plaintext password — this is a hash only.
  passwordHash String @map("password_hash")

  // Nullable at the database level: the current sign-up form always
  // collects a name, but future entry points (e.g. invites, OAuth)
  // may not.
  name String?
  bio  String? @db.Text

  avatarType         AvatarType @default(INITIALS) @map("avatar_type")
  avatarEmoji        String?    @map("avatar_emoji")
  avatarBackground   String?    @map("avatar_background")
  avatarImageUrl     String?    @map("avatar_image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notes         Note[]
  categories    Category[]
  tags          Tag[]
  preferences   UserPreferences?
  conversations Conversation[]
  subscription        Subscription?
  usageEvents         UsageEvent[]
  billingTransactions BillingTransaction[]

  @@map("users")
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingProvider {
  NONE
  STRIPE
  PAYSTACK
}

enum UsageEventType {
  AI_ANALYZE
  AI_CHAT
}

model Subscription {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan   @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  provider                 BillingProvider @default(NONE)
  providerCustomerId       String?         @map("provider_customer_id")
  providerSubscriptionId   String?         @map("provider_subscription_id")
  providerPlanCode         String?         @map("provider_plan_code")
  providerEmailToken       String?         @map("provider_email_token")
  pendingCheckoutReference String?         @map("pending_checkout_reference")
  currentPeriodStart       DateTime?       @map("current_period_start")
  currentPeriodEnd         DateTime?       @map("current_period_end")
  cancelAtPeriodEnd        Boolean         @default(false) @map("cancel_at_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  billingTransactions BillingTransaction[]

  @@map("subscriptions")
}

model BillingProviderEvent {
  id        String   @id @default(cuid())
  eventKey  String   @unique @map("event_key")
  eventType String   @map("event_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("billing_provider_events")
}

model BillingTransaction {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId     String?  @map("subscription_id")
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider           BillingProvider
  providerReference  String   @unique @map("provider_reference")
  amount             Int
  currency           String
  status             String
  paidAt             DateTime? @map("paid_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("billing_transactions")
}

model UsageEvent {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     UsageEventType
  quantity Int            @default(1)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@map("usage_events")
}

enum AvatarType {
  INITIALS
  EMOJI
  IMAGE
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ChatMode {
  ASK
  AGENT
}

model Conversation {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String?
  mode  ChatMode @default(ASK)

  messages ChatMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("conversations")
}

model ChatMessage {
  id String @id @default(cuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role     ChatRole
  content  String   @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

enum SearchMode {
  KEYWORD
  SEMANTIC
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum AccentColor {
  BLUE
  PURPLE
  RED
  ORANGE
  YELLOW
  GREEN
  PINK
  WHITE
  BLACK
}

enum InterfaceDensity {
  COMFORTABLE
  COMPACT
  MINIMAL
}

enum UiFontFamily {
  INTER
  GEIST
  SYSTEM
}

model UserPreferences {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultNoteType     NoteType   @default(NOTE) @map("default_note_type")
  defaultCategoryId   String?    @map("default_category_id")
  defaultSearchMode   SearchMode @default(KEYWORD) @map("default_search_mode")
  aiAssistanceEnabled Boolean    @default(true) @map("ai_assistance_enabled")
  ragEnabled          Boolean    @default(true) @map("rag_enabled")
  reducedMotion       Boolean          @default(false) @map("reduced_motion")
  theme               ThemeMode        @default(SYSTEM)
  accentColor         AccentColor      @default(BLUE) @map("accent_color")
  interfaceDensity    InterfaceDensity @default(COMFORTABLE) @map("interface_density")
  fontFamily          UiFontFamily     @default(GEIST) @map("font_family")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

enum NoteType {
  NOTE
  LINK
  QUOTE
  CODE
  ARTICLE
  OTHER
}

model Category {
  id String @id @default(cuid())

  // Application code must store this trimmed so the per-user unique
  // constraint behaves predictably.
  name String

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes Note[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Tag {
  id String @id @default(cuid())

  // Display label (trimmed in application code).
  name String

  // Lowercased / normalized key for per-user uniqueness (Step 2).
  normalizedName String @map("normalized_name")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  noteTags NoteTag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, normalizedName])
  @@index([userId])
  @@map("tags")
}

model Note {
  id String @id @default(cuid())

  title   String
  content String @db.Text
  type    NoteType @default(NOTE)

  sourceUrl String? @map("source_url")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  embedding NoteEmbedding?

  noteTags NoteTag[]

  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, archivedAt])
  @@index([categoryId])
  @@map("notes")
}

model NoteTag {
  noteId String @map("note_id")
  tagId  String @map("tag_id")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([noteId])
  @@index([tagId])
  @@map("note_tags")
}

// One vector per note (note-level semantic search, not chunk-level RAG).
// Prisma has no native vector scalar, so the column is declared
// Unsupported and every read/write to `embedding` goes through raw SQL
// (see src/lib/notes/embedding-repository.ts) — everything else on this
// model (create/delete bookkeeping) still goes through the normal client.
model NoteEmbedding {
  id String @id @default(cuid())

  noteId String @unique @map("note_id")
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  // gemini-embedding-001 at outputDimensionality: 768. Recorded per-row
  // (not just assumed) so a future model/dimension change can be detected
  // and backfilled instead of silently comparing incompatible vectors.
  embedding  Unsupported("vector(768)")
  model      String
  dimensions Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("note_embeddings")
}
