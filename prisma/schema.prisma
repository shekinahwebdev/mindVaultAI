// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Minimum persisted shape for MindVault authentication. Login/session
// logic, roles, OAuth, and profile data are deliberately out of scope
// until they're designed.
model User {
  id String @id @default(cuid())

  // Application code must store this trimmed and lowercased so the
  // unique constraint behaves as a case-insensitive match in practice.
  email String @unique

  // Never store a plaintext password — this is a hash only.
  passwordHash String @map("password_hash")

  // Nullable at the database level: the current sign-up form always
  // collects a name, but future entry points (e.g. invites, OAuth)
  // may not.
  name String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notes         Note[]
  categories    Category[]
  tags          Tag[]
  preferences   UserPreferences?
  conversations Conversation[]

  @@map("users")
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ChatMode {
  ASK
  AGENT
}

model Conversation {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String?
  mode  ChatMode @default(ASK)

  messages ChatMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("conversations")
}

model ChatMessage {
  id String @id @default(cuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role     ChatRole
  content  String   @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

enum SearchMode {
  KEYWORD
  SEMANTIC
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

model UserPreferences {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultNoteType     NoteType   @default(NOTE) @map("default_note_type")
  defaultCategoryId   String?    @map("default_category_id")
  defaultSearchMode   SearchMode @default(KEYWORD) @map("default_search_mode")
  aiAssistanceEnabled Boolean    @default(true) @map("ai_assistance_enabled")
  ragEnabled          Boolean    @default(true) @map("rag_enabled")
  reducedMotion       Boolean    @default(false) @map("reduced_motion")
  theme               ThemeMode  @default(LIGHT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

enum NoteType {
  NOTE
  LINK
  QUOTE
  CODE
  ARTICLE
  OTHER
}

model Category {
  id String @id @default(cuid())

  // Application code must store this trimmed so the per-user unique
  // constraint behaves predictably.
  name String

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes Note[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Tag {
  id String @id @default(cuid())

  // Display label (trimmed in application code).
  name String

  // Lowercased / normalized key for per-user uniqueness (Step 2).
  normalizedName String @map("normalized_name")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  noteTags NoteTag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, normalizedName])
  @@index([userId])
  @@map("tags")
}

model Note {
  id String @id @default(cuid())

  title   String
  content String @db.Text
  type    NoteType @default(NOTE)

  sourceUrl String? @map("source_url")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  embedding NoteEmbedding?

  noteTags NoteTag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([categoryId])
  @@map("notes")
}

model NoteTag {
  noteId String @map("note_id")
  tagId  String @map("tag_id")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([noteId])
  @@index([tagId])
  @@map("note_tags")
}

// One vector per note (note-level semantic search, not chunk-level RAG).
// Prisma has no native vector scalar, so the column is declared
// Unsupported and every read/write to `embedding` goes through raw SQL
// (see src/lib/notes/embedding-repository.ts) — everything else on this
// model (create/delete bookkeeping) still goes through the normal client.
model NoteEmbedding {
  id String @id @default(cuid())

  noteId String @unique @map("note_id")
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  // gemini-embedding-001 at outputDimensionality: 768. Recorded per-row
  // (not just assumed) so a future model/dimension change can be detected
  // and backfilled instead of silently comparing incompatible vectors.
  embedding  Unsupported("vector(768)")
  model      String
  dimensions Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("note_embeddings")
}
