{
  "name": "mindvault-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "prisma generate && next dev -p 3003",
    "dev:clean": "rm -rf .next && prisma generate && next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "eslint",
    "check:types": "tsc --noEmit",
    "test": "npm run test:ci",
    "test:ci": "npm run test:ingestion:url",
    "prisma:validate": "prisma validate",
    "ci:check": "npm run prisma:validate && npm run check:types && npm run lint && npm run test:ci && npm run build",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:ingestion:url": "tsx --test src/lib/ingestion/url/*.test.ts",
    "test:tags": "tsx --test src/lib/tags/*.test.ts",
    "test:tags:unit": "tsx --test src/lib/tags/tag-normalization.test.ts src/lib/tags/tag-validation.test.ts src/lib/tags/tags-client.test.ts",
    "test:notes:tags": "tsx --test src/lib/notes/note-tag-validation.test.ts src/lib/notes/note-tags.test.ts src/lib/notes/note-list-tag-filter.test.ts",
    "test:notes:archive": "tsx --test src/lib/notes/note-archive.test.ts",
    "test:analyze": "tsx --test src/lib/ai/analyze-tag-suggestions.test.ts",
    "test:chat": "tsx --test src/components/vault/chat/chat-truthfulness.test.ts src/lib/chat/chat-title.test.ts src/lib/chat/chat-metadata.test.ts src/lib/chat/chat-validation.test.ts src/lib/chat/grounded-follow-up.test.ts src/lib/chat/grounded-turn.test.ts src/lib/chat/process-chat-message.test.ts src/lib/chat/chat-repository.test.ts src/lib/rag/conversation-context.test.ts src/lib/rag/build-retrieval-query.test.ts src/lib/rag/ask-vault-memory.test.ts src/lib/rag/ask-vault-outcomes.test.ts src/lib/rag/ask-vault-grounded-fallback.test.ts",
    "test:settings": "tsx --test src/lib/settings/settings-validation.test.ts src/lib/settings/settings-account.test.ts src/lib/settings/settings-appearance.test.ts src/lib/settings/settings-appearance-persistence.test.ts",
    "test:billing": "tsx --test src/lib/billing/billing-period.test.ts src/lib/billing/billing-storage.test.ts src/lib/billing/billing-usage.test.ts src/lib/billing/paystack/paystack-verify.test.ts",
    "embeddings:backfill": "tsx scripts/backfill-embeddings.ts",
    "mcp": "tsx scripts/mcp-server.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "framer-motion": "^13.2.0",
    "linkedom": "^0.18.13",
    "lottie-react": "^2.4.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
