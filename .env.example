# Copy this file to .env and fill in your real local PostgreSQL credentials.
# Never commit real credentials — .env is gitignored.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mindvault"

# Used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Server-side only. Powers Gemini embeddings (when EMBEDDING_PROVIDER=gemini) and optional Gemini chat answers.
# Never expose as NEXT_PUBLIC_*.
GEMINI_API_KEY=

# Capture analyze + AI Chat when using OpenAI. Required for note analysis (Analyze on Capture).
OPENAI_API_KEY=

# Optional override for Capture analyze (default: gpt-4o-mini, or OPENAI_ANSWER_MODEL)
# OPENAI_ANALYZE_MODEL=gpt-4o-mini

# Chat answer provider: gemini (default) or openai
AI_ANSWER_PROVIDER=gemini

# Optional override when using OpenAI (default: gpt-4o-mini)
# OPENAI_ANSWER_MODEL=gpt-4o-mini

# Dev-only. Email of an existing MindVault account that the local MCP
# server (`npm run mcp`) acts as. The MCP server is a separate stdio
# process and never sees the browser session cookie, so this is how it
# knows whose vault to expose. Sign up in the app first, then set this to
# that account's email. See docs/mcp.md. Never set this to a real
# production user's email outside a personal local setup.
MCP_DEV_USER_EMAIL=

# Paystack (TEST mode — server-side only; never commit real keys)
PAYSTACK_SECRET_KEY=
# Plan code from Paystack TEST dashboard or scripts/paystack-create-pro-plan.ts
PAYSTACK_PRO_PLAN_CODE=
# Public site origin for checkout callback (e.g. http://localhost:3003)
APP_URL=

# Optional one-time plan script only:
# PAYSTACK_PRO_AMOUNT_SUBUNITS=
# PAYSTACK_PRO_CURRENCY=NGN
AWS_S3_DOCUMENT_BUCKET=mindvault-documents-dev-2026
AWS_REGION=eu-north-1
AWS_PROFILE=mindvault-dev
MINDVAULT_DOCUMENT_UPLOAD_ENABLED=true