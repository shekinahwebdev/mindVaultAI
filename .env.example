# Copy this file to .env and fill in your real local PostgreSQL credentials.
# Never commit real credentials — .env is gitignored.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mindvault"

# Used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Server-side only. Powers AI-assisted analysis in Capture. Never expose as NEXT_PUBLIC_*.
GEMINI_API_KEY=

# Dev-only. Email of an existing MindVault account that the local MCP
# server (`npm run mcp`) acts as. The MCP server is a separate stdio
# process and never sees the browser session cookie, so this is how it
# knows whose vault to expose. Sign up in the app first, then set this to
# that account's email. See docs/mcp.md. Never set this to a real
# production user's email outside a personal local setup.
MCP_DEV_USER_EMAIL=
